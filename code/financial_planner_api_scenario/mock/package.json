{
  "name": "financial-planner-mock",
  "version": "1.0.0",
  "private": true,
  "description": "Financial planner scenario mock API (OpenAPI + MongoDB)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
