TYPEDB_ADDRESS=127.0.0.1:1729
TYPEDB_USER=admin
TYPEDB_PASSWORD=password
TYPEDB_TLS_ENABLED=false
TYPEDB_CONNECT_RETRIES=5
TYPEDB_CONNECT_RETRY_DELAY_SEC=1.0

# One TypeDB instance, multiple named databases.
LAYER_C_DB=guardrails_layer_c
LAYER_B_DB=guardrails_layer_b
LAYER_A_TEST_DB=guardrails_layer_a_test
