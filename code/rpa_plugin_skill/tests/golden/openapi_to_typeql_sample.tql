define
  attribute gra_client_id, value integer;
  attribute gra_client_household_name, value string;
  attribute gra_client_state_of_residence, value string;
  attribute gra_planrecommendation_id, value integer;
  attribute gra_planrecommendation_client_id, value integer;
  attribute gra_planrecommendation_status, value string;

  entity gra_client,
    owns gra_client_id @key,
    owns gra_client_household_name,
    owns gra_client_state_of_residence @card(0..1);

  entity gra_planrecommendation,
    owns gra_planrecommendation_id @key,
    owns gra_planrecommendation_client_id,
    owns gra_planrecommendation_status;
