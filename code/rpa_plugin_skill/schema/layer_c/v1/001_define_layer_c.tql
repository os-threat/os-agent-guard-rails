define
  attribute gr_registration_id, value string;
  attribute gr_source_name, value string;
  attribute gr_source_kind, value string @values("sql", "api");
  attribute gr_source_url, value string;
  attribute gr_source_description, value string;
  attribute gr_source_is_active, value boolean;

  attribute gr_credential_ref_id, value string;
  attribute gr_secret_provider, value string @values("env", "vault", "openclaw_secret", "other");
  attribute gr_secret_ref, value string;

  attribute gr_rule_id, value string;
  attribute gr_rule_name, value string;
  attribute gr_rule_nl_text, value string;
  attribute gr_rule_horn_text, value string;
  attribute gr_rule_typeql_fun, value string;
  attribute gr_rule_ast_ref, value string;
  attribute gr_rule_status, value string @values("draft", "active", "archived");

  attribute gr_task_id, value string;
  attribute gr_task_name, value string;
  attribute gr_task_description, value string;
  attribute gr_extract_plan_ref, value string;
  attribute gr_task_status, value string @values("draft", "ready", "scheduled", "archived");

  attribute gr_schedule_id, value string;
  attribute gr_schedule_mode, value string @values("once", "datetime", "cron");
  attribute gr_cron_expression, value string;
  attribute gr_schedule_at, value datetime;
  attribute gr_openclaw_job_ref, value string;
  attribute gr_schedule_enabled, value boolean;

  attribute gr_agent_profile_id, value string;
  attribute gr_agent_name, value string;
  attribute gr_agent_email, value string;

  attribute gr_setting_key, value string;
  attribute gr_setting_value, value string;

  entity gr_registered_source,
    owns gr_registration_id @key,
    owns gr_source_name,
    owns gr_source_kind,
    owns gr_source_url,
    owns gr_source_description,
    owns gr_source_is_active,
    plays gr_source_credential_binding:source,
    plays gr_source_rule_binding:source,
    plays gr_source_task_binding:source;

  entity gr_credential_ref,
    owns gr_credential_ref_id @key,
    owns gr_secret_provider,
    owns gr_secret_ref,
    plays gr_source_credential_binding:credential;

  entity gr_rule_definition,
    owns gr_rule_id @key,
    owns gr_rule_name,
    owns gr_rule_nl_text,
    owns gr_rule_horn_text,
    owns gr_rule_typeql_fun,
    owns gr_rule_ast_ref,
    owns gr_rule_status,
    plays gr_source_rule_binding:rule;

  entity gr_task_definition,
    owns gr_task_id @key,
    owns gr_task_name,
    owns gr_task_description,
    owns gr_extract_plan_ref,
    owns gr_task_status,
    plays gr_source_task_binding:task,
    plays gr_task_schedule_binding:task;

  entity gr_task_schedule,
    owns gr_schedule_id @key,
    owns gr_schedule_mode,
    owns gr_cron_expression,
    owns gr_schedule_at,
    owns gr_openclaw_job_ref,
    owns gr_schedule_enabled,
    plays gr_task_schedule_binding:schedule;

  entity gr_agent_profile,
    owns gr_agent_profile_id @key,
    owns gr_agent_name,
    owns gr_agent_email;

  entity gr_setting,
    owns gr_setting_key @key,
    owns gr_setting_value;

  relation gr_source_credential_binding,
    relates source,
    relates credential;

  relation gr_source_rule_binding,
    relates source,
    relates rule;

  relation gr_source_task_binding,
    relates source,
    relates task;

  relation gr_task_schedule_binding,
    relates task,
    relates schedule;
