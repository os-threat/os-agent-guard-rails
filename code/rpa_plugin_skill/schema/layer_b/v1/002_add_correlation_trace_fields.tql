define
  attribute grb_correlation_id, value string;
  attribute grb_layer_a_ref, value string;

redefine
  entity grb_assessment,
    owns grb_correlation_id,
    owns grb_layer_a_ref @card(0..1);

redefine
  entity grb_data_trace,
    owns grb_correlation_id,
    owns grb_layer_a_ref @card(0..1);
