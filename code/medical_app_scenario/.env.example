# Postgres container config
POSTGRES_DB=medical_mini_app
POSTGRES_USER=medical_app
POSTGRES_PASSWORD=medical_app_dev_pw
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# API config (for local node server in web/)
API_PORT=8081

# Optional pgAdmin profile (`docker compose --profile admin up -d`)
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5051
